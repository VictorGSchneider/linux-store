// Design tokens. Every color, size, radius and font size of the UI lives here.
export global Theme {
    // colors
    out property <color> background: #2b2b2b;
    out property <color> top-background: #3a3a3a;
    out property <color> surface: #444444;
    out property <color> surface-hover: #505050;
    out property <color> pill: #f2f2f2;
    out property <color> pill-hover: #ffffff;
    out property <color> pill-text: #1c1c1c;
    out property <color> pill-text-dim: #6a6a6a;
    out property <color> chip-selected: #8ab4f8;
    out property <color> text: #f2f2f2;
    out property <color> text-dim: #b0b0b0;
    out property <color> on-accent: #ffffff;
    out property <color> line: #6a6a6a;
    out property <color> focus-ring: #8ab4f8;
    out property <color> marker: #5fd38d;
    out property <color> marker-text: #12301f;
    out property <color> error: #ff9c94;
    out property <color> disabled-text: #8a8a8a;
    out property <color> remove: #ffd3cf;
    // sizes
    out property <length> page-padding: 24px;
    out property <length> content-max-width: 1400px;
    out property <length> card-width: 148px;
    out property <length> card-visual-height: 104px;
    out property <length> card-height: 172px;
    out property <length> card-gap: 16px;
    out property <length> card-padding: 8px;
    out property <length> icon-size: 64px;
    out property <length> row-header-height: 36px;
    out property <length> row-gap: 12px;
    out property <length> pill-height: 36px;
    out property <length> pill-padding: 24px;
    out property <length> search-height: 40px;
    out property <length> search-max-width: 640px;
    out property <length> chip-height: 40px;
    out property <length> marker-size: 18px;
    out property <length> focus-ring-width: 2px;
    // radii
    out property <length> radius-card: 14px;
    out property <length> radius-visual: 10px;
    // font sizes
    out property <length> font-title: 16px;
    out property <length> font-button: 16px;
    out property <length> font-search: 16px;
    out property <length> font-chip: 13px;
    out property <length> font-chip-count: 10px;
    out property <length> font-card-name: 13px;
    out property <length> font-card-source: 11px;
    out property <length> font-card-text: 11px;
    out property <length> font-initial: 40px;
    out property <length> font-marker: 12px;
    out property <length> font-message: 16px;
    out property <length> font-page-title: 28px;
    out property <length> font-body: 14px;
    out property <length> page-icon-size: 96px;
}

// The initial of a name, for text cards. Slint cannot slice strings, so the host
// implements this callback (see `main.rs`).
export global TextUtil {
    pure callback initial(string) -> string;
}
